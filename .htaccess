# ClassControl - Configuración de seguridad simple

# Evitar listado de directorios
Options -Indexes

# Bloquear acceso a carpetas sensibles
<FilesMatch "^\.">
    Deny from all
</FilesMatch>

# Bloquear acceso a src, database, logs
<Files ~ "^(src/|database/|logs/|\.git|\.env)">
    Deny from all
</Files>
